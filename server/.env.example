# ------------------------------------------------------------------
# KOCopilot 后端环境变量
# 用法：
#   cp .env.example .env
#   chmod 600 .env       # Linux：保护 API Key
#   编辑 .env 填入真实值
# ------------------------------------------------------------------

# === 服务监听 ===
# 本地开发推荐 8090（与前端 demo 共用一个进程）
# 生产 systemd 部署推荐 5000，由 nginx 反代到 127.0.0.1:5000
HOST=127.0.0.1
PORT=8090

# === LLM Provider 选择 ===
# 可选：deepseek | mock
# mock 模式不需要 API Key，所有接口返回示例文本，方便前端开发
LLM_PROVIDER=mock

# DeepSeek 官方端点
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通用 LLM 调用参数
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# === ASR Provider 选择 ===
# 可选：mock | doubao
# mock 不调任何外部 API，返回示例转写文本，用于前端联调
ASR_PROVIDER=mock

# 火山引擎豆包大模型录音文件识别 - 极速版（turbo / flash）
# 控制台：https://console.volcengine.com/speech/app
# 资源 ID 必须是 volc.bigasr.auc_turbo（极速版专用，跟标准版不一样！）
# 端点：/api/v3/auc/bigmodel/recognize/flash 一次请求拿结果，无需轮询
DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_RECOGNIZE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash

# ASR 单次请求超时（秒），极速版正常 1-5s 返回，60 给足重试余量
ASR_TIMEOUT_SECONDS=60

# === CORS（生产环境填你的域名） ===
# 多域名用逗号分隔。本地开发 * 即可
CORS_ORIGINS=*

# === 日志 ===
LOG_LEVEL=INFO
LOG_DIR=./logs

# === 静态文件根（FastAPI 提供前端页面） ===
# 默认指向上层目录（即 d:/nocode/koc-copilot/）
# 生产可改为 /opt/kocopilot
STATIC_ROOT=..
